{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Testly",
  "colors": {
    "primary": "#10B981",
    "light": "#10B981",
    "dark": "#10B981"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.testly.com/dashboard"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Criar Conta Grátis",
      "href": "https://testly.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentação",
        "groups": [
          {
            "group": "Primeiros Passos",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "React SDK",
            "pages": [
              "sdk/installation",
              "sdk/use-experiment",
              "sdk/use-conversion",
              "sdk/configuration"
            ]
          },
          {
            "group": "Guias",
            "pages": [
              "guides/best-practices",
              "guides/debugging",
              "guides/statistical-significance"
            ]
          }
        ]
      },
      {
        "tab": "Exemplos",
        "groups": [
          {
            "group": "Casos de Uso",
            "pages": [
              "examples/hero-section",
              "examples/pricing-page",
              "examples/call-to-action",
              "examples/onboarding-flow"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Visão Geral",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/experiments/list",
              "api-reference/experiments/get",
              "api-reference/experiments/create",
              "api-reference/variants/assign",
              "api-reference/events/impression",
              "api-reference/events/conversion"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://testly.com/dashboard",
          "icon": "chart-line"
        },
        {
          "anchor": "Comunidade",
          "href": "https://discord.gg/testly",
          "icon": "discord"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/testly/sdk-react",
          "icon": "github"
        }
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/testly",
      "github": "https://github.com/testly",
      "linkedin": "https://linkedin.com/company/testly"
    }
  }
}